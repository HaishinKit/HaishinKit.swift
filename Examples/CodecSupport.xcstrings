    },
    "VideoToolbox lists encoders. Hardware decoding is checked for selected common formats and encoder-listed formats only. Software decoding is not tested; other formats may still play.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VideoToolbox lists encoders. Hardware decoding is checked for selected common formats and encoder-listed formats only. Software decoding is not tested; other formats may still play."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VideoToolboxのエンコーダー情報を表示します。ハードウェアデコードの照会範囲は主な形式とエンコーダーが列挙された形式のみです。ソフトウェアデコードは未判定で、ほかの形式も再生できる可能性があります。"
          }
        }
      }
    },
