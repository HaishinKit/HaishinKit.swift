    },
    "Enter an HTTP or HTTPS base URL with a valid port and no credentials, path, or query.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なポートを持つHTTPまたはHTTPSのベースURLを入力してください。認証情報、パス、クエリは含めないでください。"
          }
        }
      }
    },
    "Enter your stream endpoint, then start playback.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
