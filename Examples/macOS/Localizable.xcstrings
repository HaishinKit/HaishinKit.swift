{
  "sourceLanguage": "en",
  "strings": {
    "%@ You can retry the same package.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 同じパッケージで再試行できます。"
          }
        }
      }
    },
    "%@ copy": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のコピー"
          }
        }
      }
    },
    "10-bit HLG over Enhanced RTMP requires a compatible server and player.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhanced RTMPで10-bit HLGを使用するには、対応するサーバーとプレーヤーが必要です。"
          }
        }
      }
    },
    "1080 × 1920 (portrait)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1080 × 1920（縦向き）"
          }
        }
      }
    },
    "4-digit connection code": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4桁の接続コード"
          }
        }
      }
    },
    "A capture input track is invalid.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャ入力のトラックが不正です。"
          }
        }
      }
    },
    "A scene supports at most 256 media files.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのシーンに保存できる素材は256ファイルまでです。"
          }
        }
      }
    },
    "A text object's font size is invalid.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストのフォントサイズが不正です。"
          }
        }
      }
    },
    "AAC is widely supported. Opus offers better quality at low bitrates.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AACは幅広く対応しています。Opusは低ビットレートでも高い音質を得られます。"
          }
        }
      }
    },
    "API documentation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIドキュメント"
          }
        }
      }
    },
    "AVCaptureSession": {
      "shouldTranslate": false
    },
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリについて"
          }
        }
      }
    },
    "Accepted by VQMetrix: %@. Check the receiver for evaluation results.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VQMetrixが受け付けました：%@。評価結果は受信側で確認してください。"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "Add an object to compose this scene.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オブジェクトを追加してシーンを作成します。"
          }
        }
      }
    },
    "Add object": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オブジェクトを追加"
          }
        }
      }
    },
    "App version": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのバージョン"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観"
          }
        }
      }
    },
    "Appearance overrides apply until the app closes. Each launch follows the system setting.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観の変更はアプリを終了するまで有効です。起動時はシステム設定に従います。"
          }
        }
      }
    },
    "Applied when the publisher opens. Audio Engine keeps microphone input separate from camera capture.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信画面を開いたときに適用します。Audio Engineはマイク入力をカメラのキャプチャから分離します。"
          }
        }
      }
    },
    "Apply canvas size": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスサイズを適用"
          }
        }
      }
    },
    "Apply layout": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配置を適用"
          }
        }
      }
    },
    "Apply text": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを適用"
          }
        }
      }
    },
    "Audio Capture": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声キャプチャ"
          }
        }
      }
    },
    "Audio Codec Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声コーデック設定"
          }
        }
      }
    },
    "Audio Engine (recommended)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Engine（推奨）"
          }
        }
      }
    },
    "Audio format": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声形式"
          }
        }
      }
    },
