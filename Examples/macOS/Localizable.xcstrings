      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューのサンプルを取得"
          }
        }
      }
    },
    "Capturing %lld / %lld frames…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld フレームをキャプチャ中…"
          }
        }
      }
    },
    "Change shared content…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有する画面を変更…"
          }
        }
      }
    },
    "Changes apply to the next session. AAC and average bitrate are a good starting point.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は次回の接続から適用されます。まずはAACと平均ビットレートでお試しください。"
          }
        }
      }
    },
    "Choose a stream to watch": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴するストリームを選択"
          }
        }
      }
    },
    "Choose content in the macOS sharing picker. Microphone audio follows Settings → Capture.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの共有ピッカーで画面を選択します。マイク音声は「設定 → キャプチャ」に従います。"
          }
        }
      }
    },
