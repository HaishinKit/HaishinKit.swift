      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声：%lld kbps"
          }
        }
      }
    },
    "BitRate Mode": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビットレートモード"
          }
        }
      }
    },
    "Bitrate mode": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビットレートモード"
          }
        }
      }
    },
    "Bonjour announcement failed: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjourでの公開に失敗しました：%@"
          }
        }
      }
    },
    "Bonjour search failed: %@. Check local network access in System Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjourの検索に失敗しました：%@。システム設定でローカルネットワークへのアクセスを確認してください。"
          }
        }
      }
    },
    "Bonjour service": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjourサービス"
          }
        }
      }
    },
    "Camera preview": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラのプレビュー"
          }
        }
      }
    },
    "Camera unavailable or access not granted. You can share a screen or window instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが利用できないか、アクセスが許可されていません。画面またはウィンドウを共有できます。"
          }
        }
      }
    },
    "Camera: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ：%@"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Cancel receiving": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信をキャンセル"
          }
        }
      }
    },
    "Cancelling…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル中…"
          }
        }
      }
    },
    "Cannot allocate I420 pixels.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "I420のピクセルバッファを確保できません。"
          }
        }
      }
    },
    "Cannot allocate reference pixels.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照映像のピクセルバッファを確保できません。"
          }
        }
      }
    },
    "Cannot copy compressed packet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮パケットをコピーできません。"
          }
        }
      }
    },
    "Cannot create I420 sample.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "I420のサンプルを作成できません。"
          }
        }
      }
    },
    "Cannot describe I420 pixels.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "I420の映像形式を作成できません。"
          }
        }
      }
    },
    "Cannot encode frame.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームをエンコードできません。"
          }
        }
      }
    },
    "Cannot read the local receiver address.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの受信側アドレスを読み取れません。"
          }
        }
      }
    },
    "Cannot resolve the local receiver. Check its address and that reception is running.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの受信側を解決できません。アドレスと受信が開始されているかを確認してください。"
          }
        }
      }
    },
    "Cannot start encoder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンコーダーを開始できません。"
          }
        }
      }
    },
    "Canvas presets": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスのプリセット"
          }
        }
      }
    },
    "Capture": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャ"
          }
        }
      }
    },
    "Capture 3 seconds of the composed preview at 640 × 360, 15 fps.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合成したプレビューを640 × 360・15fpsで3秒間キャプチャします。"
          }
        }
      }
    },
    "Capture Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャ設定"
          }
        }
      }
    },
    "Capture and upload a quality comparison": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画質比較用の映像をキャプチャして送信"
          }
        }
      }
    },
    "Capture cancelled.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャをキャンセルしました。"
          }
        }
      }
