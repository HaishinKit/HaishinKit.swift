    },
    "Play a stream from an RTMP, RTMPS or SRT server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a stream from an RTMP, RTMPS or SRT server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RTMP・RTMPS・SRTサーバーからストリームを再生します。"
          }
        }
      }
    },
    "Server URL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server URL"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーURL"
          }
        }
      }
    },
    "Stream name / key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stream name / key"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーム名 / キー"
          }
        }
      }
    },
    "For SRT, enter the complete URL including the port and any stream options. Changes apply to the next connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For SRT, enter the complete URL including the port and any stream options. Changes apply to the next connection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SRTではポートと接続オプションを含む完全なURLを入力してください。変更は次の接続から適用されます。"
          }
        }
      }
    },
    "No valid source": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No valid source"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続先を設定してください"
