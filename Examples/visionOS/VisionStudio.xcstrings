    },
    "Enter a valid RTMP/RTMPS URL and stream name, or an SRT URL with a port.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid RTMP/RTMPS URL and stream name, or an SRT URL with a port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なRTMP・RTMPS URLとストリーム名、またはポート付きのSRT URLを入力してください。"
          }
        }
      }
    },
    "The stream disconnected. Check the server and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stream disconnected. Check the server and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れました。サーバーを確認し、もう一度再生してください。"
          }
        }
      }
    },
    "Check your server address, stream name and network, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your server address, stream name and network, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーURL、ストリーム名、ネットワークを確認し、もう一度再生してください。"
          }
        }
      }
    }
