    "1280 × 720 · 30 fps · H.264 / AAC": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1280 × 720 · 30 fps · H.264 / AAC"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1280 × 720 · 30 fps · H.264 / AAC"
          }
        }
      }
    },
    "Send moving color bars and stereo test tone: L 440 Hz / R 880 Hz. No camera or microphone is used.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send moving color bars and stereo test tone: L 440 Hz / R 880 Hz. No camera or microphone is used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動くカラーバーとステレオのテスト音（左440 Hz / 右880 Hz）を送信します。カメラやマイクは使用しません。"
          }
        }
      }
    },
    "Unable to connect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to connect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できません"
          }
        }
      }
    },
    "Enter a valid RTMP/RTMPS URL and stream name, or an SRT caller URL with a port.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid RTMP/RTMPS URL and stream name, or an SRT caller URL with a port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なRTMP・RTMPS URLとストリーム名、またはポート付きのSRT caller URLを入力してください。"
          }
        }
      }
    },
    "SRT uses caller connections only. Enter the port and stream options; listener and rendezvous modes are not supported here. Changes apply to the next connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SRT uses caller connections only. Enter the port and stream options; listener and rendezvous modes are not supported here. Changes apply to the next connection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SRTはcaller接続のみ対応します。ポートとストリームのオプションを入力してください。listener・rendezvousは対象外です。変更は次の接続から適用されます。"
          }
        }
      }
    },
    "Use one application path in the RTMP server URL (for example, /live). Put stream path components in Stream name / key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use one application path in the RTMP server URL (for example, /live). Put stream path components in Stream name / key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RTMPのサーバーURLはアプリ名1階層（例：/live）まで入力してください。ストリームの階層は「ストリーム名 / キー」に指定します。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
